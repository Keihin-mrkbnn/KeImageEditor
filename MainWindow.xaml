<Window
    x:Class="KeImageEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="KeImageEditor">

    <Grid Padding="20" Background="#202020">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />     <!--基画像-->
            <ColumnDefinition Width="Auto" />   <!--やじるし-->
            <ColumnDefinition Width="3*" />     <!--出力画像-->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />     <!--メニュー-->
            <RowDefinition Height="Auto" />     <!--基画像-->
            <RowDefinition Height="Auto" />     <!--マスク画像-->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 基画像 -->
        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="10">
            <Border x:Name="BaseImageCard"
                    Background="#2A2A2A"
                    CornerRadius="8"
                    Padding="10"
                    Height="200"
                    AllowDrop="True"
                    PointerEntered="OnCardPointerEntered"
                    PointerExited="OnCardPointerExited"
                    DragOver="OnCardDragOver"
                    Drop="OnBaseImageDrop"
                    Tapped="OnBaseImageAreaTapped">
                <Grid>
                    <TextBlock x:Name="BaseHintLabel"
                               Text="Ｄ＆Ｄまたはクリックで画像を参照"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#888"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Opacity="0.7" />
                    <Image x:Name="BaseThumbnail"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.9" />
                </Grid>
            </Border>

            <TextBlock x:Name="BaseLabel"
                       Text="基画像"
                       HorizontalAlignment="Center"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- マスク画像 -->
        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="10" Margin="0,15,0,0">
            <Border x:Name="MaskImageCard"
                    Background="#2A2A2A"
                    CornerRadius="8"
                    Padding="10"
                    Height="200"
                    AllowDrop="True"
                    PointerEntered="OnCardPointerEntered"
                    PointerExited="OnCardPointerExited"
                    DragOver="OnCardDragOver"
                    Drop="OnMaskImageDrop"
                    Tapped="OnMaskImageAreaTapped">
                <Grid>
                    <TextBlock x:Name="MaskHintLabel"
                               Text="Ｄ＆Ｄまたはクリックで画像を参照"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#888"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Opacity="0.7" />
                    <Image x:Name="MaskThumbnail"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.9" />
                </Grid>
            </Border>

            <TextBlock x:Name="MaskLabel"
                       Text="マスク画像"
                       HorizontalAlignment="Center"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 矢印 -->
        <StackPanel Grid.Column="1"
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
            <TextBlock Text="▶"
                       Foreground="White"
                       FontSize="40"
                       Margin="10,204,10,0"/>
        </StackPanel>

        <!-- 出力画像 -->
        <StackPanel Grid.Column="2" Grid.Row="1" Grid.RowSpan="3" Spacing="10" >
            <Border Background="#2A2A2A"
                    CornerRadius="8"
                    Padding="10"
                    Height="450">
                <Image x:Name="ImagePreview"
                       Stretch="Uniform" />
            </Border>

            <!-- 下側に配置 -->
            <TextBlock Text="出力画像"
                       HorizontalAlignment="Center"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,5,0,0" />
            

            <Button Content="保存"
                    CornerRadius="8"
                    HorizontalAlignment="right"
                    Margin="0,-42,0,0"
                    Padding="20,5"
                    Background="#0078D4"
                    Foreground="White"
                    Click="OnSaveClick" />
        </StackPanel>

        <!-- ヘルプ -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Button Content="ヘルプ（外部リンク）"
                    CornerRadius="8"
                    HorizontalAlignment="left"
                    Margin="0,0,0,10"
                    Padding="10,5"
                    Background="#444"
                    Foreground="White"
                    Click="OnHelpClick" />
        </StackPanel>
    </Grid>
</Window>
